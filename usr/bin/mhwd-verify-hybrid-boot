#!/usr/bin/env bash
#
# mhwd-verify-hybrid-boot — detect a hybrid GPU at boot and apply the matching
# biglinux-gpu-manager mode. Run by nvidia-manager-verify.service before the
# display manager. The live-CD GRUB may request a mode via bignvidia= on the
# kernel cmdline (see iso-profiles .../grub/cfg/kernels.cfg).

#-------------------------------------------------------------------------------
# Fix video device permission in live mode, added 2026/01/28 to fix the nvidia
# proprietary driver in the live ISO.
#-------------------------------------------------------------------------------
if [[ -e /livefs-pkgs.txt ]]; then
    chmod 666 /dev/dri/renderD* 2>/dev/null
fi

# Already configured → nothing to do. A persisted mode (set by a previous
# run on an installed system, including a user-chosen 'integrated') is the
# authoritative signal; switcheroo-control being enabled covers the AMD-hybrid
# case where no mode file is written. Honouring the mode file keeps the user's
# choice sticky across reboots instead of silently reverting to hybrid.
if [[ -s /etc/biglinux-gpu-mode ]] || systemctl -q is-enabled switcheroo-control 2>/dev/null; then
    exit 0
fi

# A hybrid system exposes more than one graphics controller.
gpu_list="$(lspci | grep -iE 'VGA|3D|Display')"
gpu_count="$(grep -c . <<<"$gpu_list")"
((gpu_count > 1)) || exit 0

if grep -qi nvidia <<<"$gpu_list"; then
    # NVIDIA hybrid: honour the mode requested on the cmdline, else hybrid.
    # biglinux-gpu-manager enables switcheroo-control for hybrid/nvidia.
    case " $(cat /proc/cmdline) " in
    *" bignvidia=nvidia "*) biglinux-gpu-manager nvidia ;;
    *" bignvidia=integrated "*) biglinux-gpu-manager integrated ;;
    *) biglinux-gpu-manager hybrid ;;
    esac
elif grep -qiE 'radeon|amd|ati' <<<"$gpu_list"; then
    # AMD hybrid (AMD APU + AMD dGPU): just expose switcheroo-control.
    systemctl enable --now switcheroo-control
fi

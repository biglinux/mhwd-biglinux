#!/usr/bin/env bash
#
# biglinux-gpu-manager — slim hybrid-GPU mode switcher for BigLinux
#
# Usage: biglinux-gpu-manager [hybrid|nvidia|integrated]
#
# This is a THIN override layer on top of the mhwd PRIME profile
# (video-hybrid-*-nvidia-prime). That profile already ships the complete,
# correct modern setup when installed:
#   - PRIME render offload Xorg config (/etc/X11/mhwd.d/nvidia.conf)
#   - RTD3 udev rules (/etc/udev/rules.d/90-mhwd-prime-powermanagement.rules)
#   - options nvidia NVreg_DynamicPowerManagement=0x02 (in /etc/modprobe.d/mhwd-gpu.conf)
#   - nvidia-drm force-load (/etc/modules-load.d/mhwd-gpu.conf)
#   - switcheroo-control / nvidia-prime as dependencies
#   - open vs proprietary kernel module selection (nvidia-recommended-driver)
# Suspend/resume options live in nvidia-utils' /usr/lib/modprobe.d/nvidia-sleep.conf
# and the nvidia-{suspend,resume,hibernate}.service units (enabled by preset).
#
# So this tool only writes the DEVIATIONS from that hybrid baseline:
#   hybrid      (default) Remove our overrides → the mhwd profile drives:
#               iGPU displays, NVIDIA dGPU on demand via prime-run, RTD3 idle.
#   nvidia      Keep the dGPU awake (RTD3 off) and make it the Xorg PrimaryGPU.
#               On a muxless laptop under Wayland the internal panel stays on
#               the iGPU, so this is mainly an Xorg effect.
#   integrated  iGPU only: prevent the nvidia modules from loading at all
#               (defeats the mhwd modules-load force-load). Best battery life.
#
# The override drop-in is named zz-* so it sorts AFTER mhwd-gpu.conf and wins
# the modprobe merge for NVreg_DynamicPowerManagement. We never touch the
# mhwd-owned files, nvidia-drm.modeset (driver/biglinux-improve-compatibility
# default), or /etc/default/grub.

set -uo pipefail

readonly MODE_FILE='/etc/biglinux-gpu-mode'
readonly NVIDIA_MODE_CONF='/etc/modprobe.d/zz-biglinux-nvidia-mode.conf'
readonly NVIDIA_PRIMARY_CONF='/etc/X11/xorg.conf.d/99-biglinux-nvidia-primary.conf'

# --- hardware detection -------------------------------------------------------
gpu_list="$(lspci 2>/dev/null | grep -iE 'VGA|3D|Display')"

has_nvidia=false
grep -qiE 'NVIDIA' <<<"$gpu_list" && has_nvidia=true

has_igpu=false
grep -qiE 'Intel|AMD|ATI' <<<"$gpu_list" && has_igpu=true

# No NVIDIA dGPU: nothing for this tool to manage.
if [[ $has_nvidia != true ]]; then
    echo 'biglinux-gpu-manager: no NVIDIA dGPU detected; nothing to do.'
    exit 0
fi

# --- helpers ------------------------------------------------------------------
need_initramfs=false

enable_switcheroo() {
    # switcheroo-control is a hard dependency, so it is always installed. The
    # mhwd profile pulls it too, but enabling the service is still our job.
    if ! systemctl -q is-enabled switcheroo-control 2>/dev/null; then
        systemctl enable --now switcheroo-control
    fi
}

# Write $1 from stdin only when the content differs. Exit 0 when it changed.
write_if_changed() {
    local path="$1" content
    content="$(cat)"
    if [[ -e $path && "$(<"$path")" == "$content" ]]; then
        return 1
    fi
    install -d "$(dirname "$path")"
    printf '%s\n' "$content" >"$path"
    return 0
}

# Remove $1 if present. Exit 0 when it removed something.
remove_if_present() {
    [[ -e $1 ]] || return 1
    rm -f "$1"
    return 0
}

write_nvidia_primary_xorg() {
    write_if_changed "$NVIDIA_PRIMARY_CONF" <<'EOF'
# Managed by biglinux-gpu-manager (mode: nvidia). Do not edit.
Section "OutputClass"
    Identifier "biglinux-nvidia-primary"
    MatchDriver "nvidia-drm"
    Driver "nvidia"
    Option "AllowEmptyInitialConfiguration"
    Option "PrimaryGPU" "yes"
EndSection
EOF
}

# --- mode resolution ----------------------------------------------------------
mode="${1:-}"
if [[ -z $mode ]]; then
    [[ -r $MODE_FILE ]] && mode="$(<"$MODE_FILE")"
    mode="${mode:-hybrid}"
fi

case "$mode" in
hybrid)
    # Drop all overrides; the mhwd PRIME profile provides the hybrid baseline
    # (RTD3 0x02, offload Xorg, force-loaded nvidia-drm).
    remove_if_present "$NVIDIA_MODE_CONF" && need_initramfs=true
    remove_if_present "$NVIDIA_PRIMARY_CONF"
    enable_switcheroo
    ;;
nvidia)
    # Override mhwd's RTD3 0x02 with 0x00 (zz-* wins the merge) and make the
    # dGPU the Xorg primary.
    write_if_changed "$NVIDIA_MODE_CONF" <<'EOF' && need_initramfs=true
# Managed by biglinux-gpu-manager (mode: nvidia). Do not edit.
options nvidia NVreg_DynamicPowerManagement=0x00
EOF
    write_nvidia_primary_xorg
    enable_switcheroo
    ;;
integrated)
    if [[ $has_igpu != true ]]; then
        echo 'biglinux-gpu-manager: integrated mode needs an integrated GPU; aborting.' >&2
        exit 1
    fi
    # blacklist stops autoload; install /bin/false also defeats the explicit
    # nvidia-drm force-load from mhwd's /etc/modules-load.d/mhwd-gpu.conf.
    write_if_changed "$NVIDIA_MODE_CONF" <<'EOF' && need_initramfs=true
# Managed by biglinux-gpu-manager (mode: integrated). Do not edit.
blacklist nvidia
blacklist nvidia_drm
blacklist nvidia_modeset
blacklist nvidia_uvm
install nvidia /bin/false
install nvidia_drm /bin/false
install nvidia_modeset /bin/false
install nvidia_uvm /bin/false
EOF
    remove_if_present "$NVIDIA_PRIMARY_CONF"
    ;;
*)
    echo "Usage: ${0##*/} [hybrid|nvidia|integrated]" >&2
    exit 2
    ;;
esac

echo "$mode" >"$MODE_FILE"

# Rebuild the initramfs only when the modprobe state actually changed.
if [[ $need_initramfs == true ]]; then
    mkinitcpio -P
fi

echo "biglinux-gpu-manager: applied mode '$mode'."

# Re-apply the persisted GPU mode after mhwd rewrites its Xorg outputclass,
# so the biglinux-owned drop-ins stay consistent. Mode is a name now
# (hybrid|nvidia|integrated); biglinux-gpu-manager is idempotent.
if [[ -e /etc/biglinux-gpu-mode ]]; then
    biglinuxGpuMode=$(</etc/biglinux-gpu-mode)

    if [[ -n "$biglinuxGpuMode" ]]; then
        biglinux-gpu-manager "$biglinuxGpuMode"
    fi
fi

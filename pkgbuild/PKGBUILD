# Maintainer: Barnabé di Kartola <barnabedikartola@gmail.com>

pkgname=mhwd-biglinux
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
pkgdesc="Support for linux-xanmod and linux-big, and improved hybrid GPU handling"
arch=('any')
url="https://github.com/biglinux/$pkgname"
license=('GPL-3.0-or-later')
depends=('mhwd' 'mhwd-nvidia-580xx' 'switcheroo-control')
provides=("$pkgname")
optdepends=('nvidia-prime: prime-run wrapper for PRIME render offload')
# Build from local committed code. For a remote/CI build, swap to the line below.
#source=("git+${url}.git")
source=("git+file://${PWD%/*}")
md5sums=('SKIP')
if [ -e "${pkgname}.install" ];then
    install=${pkgname}.install
fi


package() {

    InternalDir="${srcdir}/${pkgname}"

    # Copy files
    if [ -d "${InternalDir}/usr" ]; then
        cp -r "${InternalDir}/usr" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/etc" ]; then
        cp -r "${InternalDir}/etc" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/opt" ]; then
        cp -r "${InternalDir}/opt" "${pkgdir}/"
    fi
}
